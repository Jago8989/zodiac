# Block-explorer API key (Etherscan V2 works across all supported chains).
# Optionally override per network, e.g. ETHERSCAN_API_KEY_GNOSIS=...
ETHERSCAN_API_KEY=

# Infura key — used to build RPC URLs for chains Infura serves (optional).
INFURA_KEY=
ALCHEMY_KEY=

# Deployment signing.
# By default `zodiac deploy` signs transactions locally from this mnemonic.
MNEMONIC=
# Set DEPLOY_VIA_FRAME to a truthy value (1/true/yes/on) to instead sign through
# a locally running Frame wallet (https://frame.sh). MNEMONIC is then ignored.
DEPLOY_VIA_FRAME=